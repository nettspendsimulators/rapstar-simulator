[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/marketing_hub_screen.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/ui/data_table.gd" id="2_table"]

[node name="MarketingHubScreen" type="MarginContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Marketing"

[node name="MoneyLabel" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="Hint" type="Label" parent="Column"]
layout_mode = 2
text = "Clique em uma música ou projeto para montar a campanha. Marketing amplia alcance e potencial, mas não garante retorno."

[node name="ContentTable" type="Tree" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2_table")

[node name="BackButton" type="Button" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Voltar"
