[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/project_editor_screen.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/ui/data_table.gd" id="2_table"]
[ext_resource type="PackedScene" path="res://scenes/components/cover_picker.tscn" id="3_cover"]

[node name="ProjectEditorScreen" type="MarginContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Criar Projeto"

[node name="FormatInfo" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
autowrap_mode = 3

[node name="Body" type="HBoxContainer" parent="Column"]
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/separation = 20

[node name="Form" type="PanelContainer" parent="Column/Body"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2

[node name="FormColumn" type="VBoxContainer" parent="Column/Body/Form"]
layout_mode = 2

[node name="TitleEdit" type="LineEdit" parent="Column/Body/Form/FormColumn"]
unique_name_in_owner = true
layout_mode = 2
