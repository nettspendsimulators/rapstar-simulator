[node name="AddButton" type="Button" parent="Column/Body/AvailableColumn"]
unique_name_in_owner = true
layout_mode = 2
text = "Adicionar à tracklist"

[node name="TracksColumn" type="VBoxContainer" parent="Column/Body"]
layout_mode = 2
