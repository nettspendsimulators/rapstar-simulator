max_length = 60

[node name="FormatOption" type="OptionButton" parent="Column/Body/Form/FormColumn"]
unique_name_in_owner = true
layout_mode = 2

[node name="CoverPicker" parent="Column/Body/Form/FormColumn" instance=ExtResource("3_cover")]
