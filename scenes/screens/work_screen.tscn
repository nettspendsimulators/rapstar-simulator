[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/work_screen.gd" id="1_script"]
[ext_resource type="Script" path="res://scripts/ui/data_table.gd" id="2_table"]

[node name="WorkScreen" type="MarginContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Trabalhar"

[node name="Hint" type="Label" parent="Column"]
layout_mode = 2
text = "Precisa de dinheiro? Um trabalho paga um valor fixo e ocupa a semana inteira: ao confirmar, a semana avança (lançamentos, plataformas e shows da semana acontecem normalmente)."
autowrap_mode = 3

[node name="JobsTable" type="Tree" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
script = ExtResource("2_table")

[node name="MessageLabel" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
theme_type_variation = &"MessageLabel"

[node name="ButtonRow" type="HBoxContainer" parent="Column"]
layout_mode = 2

[node name="BackButton" type="Button" parent="Column/ButtonRow"]
