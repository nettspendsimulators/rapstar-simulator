[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/ui/screens/platforms_screen.gd" id="1_script"]

[node name="PlatformsScreen" type="MarginContainer"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1_script")

[node name="Column" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 16

[node name="Title" type="Label" parent="Column"]
layout_mode = 2
theme_type_variation = &"TitleLabel"
text = "Plataformas"

[node name="SummaryLabel" type="Label" parent="Column"]
unique_name_in_owner = true
layout_mode = 2

[node name="Tiles" type="GridContainer" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_constants/h_separation = 16
theme_override_constants/v_separation = 16
columns = 4

[node name="BackButton" type="Button" parent="Column"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 0
text = "Voltar"
