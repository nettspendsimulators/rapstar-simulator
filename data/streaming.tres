[gd_resource type="Resource" script_class="StreamingRules" format=3]

[ext_resource type="Script" path="res://scripts/definitions/streaming_rules.gd" id="1_rules"]
[ext_resource type="Script" path="res://scripts/definitions/platform_definition.gd" id="2_platform"]
[ext_resource type="Script" path="res://scripts/definitions/trajectory_definition.gd" id="3_trajectory"]

[sub_resource type="Resource" id="platform_spotify"]
script = ExtResource("2_platform")
id = "spotify"
display_name = "Spotify"
description = "A maior vitrine de streaming, onde produção bem cuidada faz diferença."
audience_share = 0.45
affinity_attribute = "production"
affinity_strength = 0.4
money_per_play = 0.01
listeners_per_play = 0.3
followers_per_play = 0.02
listeners_label = "Ouvintes mensais"
followers_label = "Seguidores"
plays_label = "Streams"
catalog_label = "Músicas populares"

