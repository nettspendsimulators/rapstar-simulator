catalog_label = "À venda"

[sub_resource type="Resource" id="platform_radio"]
script = ExtResource("2_platform")
id = "radio"
display_name = "Rádio"
description = "Só toca quem tem fama ou uma ação de Rádio na campanha."
kind = "radio"
audience_share = 0.05
money_per_play = 0.005
plays_label = "Execuções"
catalog_label = "Em rotação"
required_fame = 50
unlock_action = "radio"

