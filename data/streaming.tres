[resource]
script = ExtResource("1_rules")
platforms = Array[ExtResource("2_platform")]([SubResource("platform_spotify"), SubResource("platform_apple"), SubResource("platform_deezer"), SubResource("platform_soundcloud"), SubResource("platform_youtube"), SubResource("platform_store"), SubResource("platform_radio")])
trajectories = Array[ExtResource("3_trajectory")]([SubResource("trajectory_legacy"), SubResource("trajectory_instant_hit"), SubResource("trajectory_slow_growth"), SubResource("trajectory_steady"), SubResource("trajectory_viral"), SubResource("trajectory_delayed"), SubResource("trajectory_platform_focus"), SubResource("trajectory_underground"), SubResource("trajectory_debut_crash"), SubResource("trajectory_flop"), SubResource("trajectory_catalog_late")])
