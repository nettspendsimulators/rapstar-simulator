[resource]
script = ExtResource("1_rules")
actions = Array[ExtResource("2_action")]([SubResource("action_social"), SubResource("action_teaser"), SubResource("action_pre_save"), SubResource("action_influencers"), SubResource("action_interviews"), SubResource("action_radio"), SubResource("action_playlists"), SubResource("action_paid_ads"), SubResource("action_video")])
